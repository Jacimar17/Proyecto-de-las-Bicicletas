# Base de datos: "local" (predeterminado) o "atlas"
MONGO_MODE=local
MONGO_DB_NAME=bicicletas

# MongoDB local. En modo local, si se omite, se usa localhost:27017.
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017

# En modo atlas, ATLAS_URI es obligatorio. En modo local, configurarlo habilita
# la sincronizacion periodica local -> Atlas.
# ATLAS_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
SYNC_INTERVAL_MS=30000

# Genera un valor propio y mantenlo fuera del repositorio.
JWT_SECRET=replace-with-a-long-random-secret

# Debe coincidir con el Client ID configurado en el frontend para Google Sign-In.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com

# Puerto del backend. API_BASE_URL solo la utiliza el CLI.
PORT=3000
API_BASE_URL=http://localhost:3000

# Opcionales: contrasena inicial de admin y tecnico creada por el seed.
# SEED_ADMIN_PASSWORD=replace-this-seed-password
