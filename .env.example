# local (predeterminado): usa MongoDB instalado en esta computadora.
# atlas: conecta directamente a la base compartida de MongoDB Atlas.
MONGO_MODE=local
MONGO_DB_NAME=bicicletas

# Conexión local (opcional; si falta, usa 127.0.0.1:27017).
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017

# Para Atlas directo, descomenta estas opciones y completa la URI localmente.
# Usa la cadena estándar (sin +srv): en algunas PCs Node no resuelve las consultas SRV.
# Los hosts, replicaSet y authSource están en la pestaña "Drivers" de tu cluster en Atlas.
# No compartas ni subas credenciales reales al repositorio.
# MONGO_MODE=atlas
# ATLAS_URI=mongodb://<usuario>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority

# Clave privada para firmar los JWT. Cambiala por un valor aleatorio antes de usar la app.
JWT_SECRET=reemplazar-con-un-secreto-aleatorio
# Contraseña de admin y técnico que crea `npm run seed` (por defecto: admin123).
# SEED_ADMIN_PASSWORD=admin123
# Client ID de Google Cloud (OAuth, tipo "Aplicación web"). Es gratuito.
GOOGLE_CLIENT_ID=
PORT=3000
API_BASE_URL=http://localhost:3000
