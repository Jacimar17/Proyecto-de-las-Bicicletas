# Reemplaza el ejemplo por la URI de tu cluster MongoDB Atlas.
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=ProyectoBicicletas
# Alternativa si tu plataforma entrega DATABASE_URL (MONGO_URI tiene prioridad).
DATABASE_URL=
MONGO_DB_NAME=bicicletas_db
JWT_SECRET=cambia-este-secreto-por-uno-privado
PORT=3000
