{
  "name": "proyecto-de-las-bicicletas",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "test": "node -r ts-node/register --test tests/*.test.ts test/*.test.ts",
    "start": "node -r ts-node/register server.ts",
    "start:backend": "nodemon --exec \"node -r ts-node/register\" server.ts",
    "start:frontend": "npm --prefix frontend start",
    "predev": "kill-port 3000 4200",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "menu": "node -r ts-node/register src/cli/index.ts",
    "seed": "node -r ts-node/register src/seed.ts",
    "migrate:bicis-admin": "node -r ts-node/register src/migrations/rename-bicis-and-admin.ts",
    "build": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "concurrently": "^10.0.6",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "description": ""
}
